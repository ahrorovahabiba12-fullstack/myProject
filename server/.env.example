NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_advisor
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/ai_advisor

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

FRONTEND_URL=http://localhost:5173

# Reverse proxies in front of the API (0 = none). Set to 1 behind nginx/Caddy.
TRUST_PROXY=0

# Auth cookies are `secure` in production by default. Set to false ONLY while
# the server is reached over plain HTTP (no domain/HTTPS yet) — otherwise the
# browser drops the cookies and every login bounces back to the login page.
# COOKIE_SECURE=false

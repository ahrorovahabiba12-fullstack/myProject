# Settings for docker-compose.prod.yml. Copy to .env on the server and fill
# in every value: cp .env.example .env
# (Local development uses server/.env instead; see server/.env.example.)

# Domain whose DNS A record points at this server. Caddy gets the HTTPS
# certificate for it, so ports 80 and 443 must be open.
DOMAIN=advisor.example.uz

# Generate each with: openssl rand -hex 32
# (hex only — the Postgres password goes into a connection URL unescaped)
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# "mock" works without a key (rule-based answers); "openai" needs AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# true only for a public demo site: creates admin@demo.uz etc. with the
# published password Demo12345! on first start.
SEED_DEMO_ACCOUNTS=false
